# 복사해서 .env 로 저장한 뒤 값을 채우세요.
# config/config.yaml 의 llm.provider 에 해당하는 키만 있으면 됩니다.

# --- LLM (provider: anthropic 일 때) ---
ANTHROPIC_API_KEY=

# --- LLM (provider: openai 일 때) ---
OPENAI_API_KEY=

# --- 5단계 발행 ---
# Discord 채널 설정 > 연동 > 웹후크 > 새 웹후크 > 웹후크 URL 복사
DISCORD_WEBHOOK_URL=

# --- 4단계 교차검증 검색 (선택, 강력 권장) ---
# 없으면 구글뉴스로 폴백하지만, 구글뉴스는 원문 링크가 암호화돼 있어
# 증인 기사의 본문을 읽을 수 없습니다. 그러면 LLM 이 제목만 보고 팩트체크합니다.
#
# [신규 발급] 네이버클라우드 플랫폼 콘솔 > NAVER API HUB > 검색(뉴스) 신청
#   2026-07-31 부터 개발자센터에서는 검색 API 신규 신청을 받지 않습니다.
NAVER_API_KEY_ID=
NAVER_API_KEY=
#
# [구 방식] 개발자센터에서 이미 받아둔 키가 있다면 이쪽을 채우세요.
#   2027-06-30 까지만 지원됩니다.
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# --- LLM (provider: gemini 일 때) ---
# https://aistudio.google.com/apikey
GOOGLE_API_KEY=

# --- LLM (provider: local 일 때) ---
# Ollama / LM Studio / vLLM 등 OpenAI 호환 서버.
# 주소는 config.yaml 의 llm.base_url.local 에서 지정합니다.
# 인증이 없는 서버라면 아래 값은 비워두세요.
LOCAL_LLM_API_KEY=

# --- 발행 채널 (쓰는 것만 채우면 됩니다) ---
# Slack: 채널 설정 > 앱 > Incoming Webhooks 에서 발급
SLACK_WEBHOOK_URL=

# Telegram: @BotFather 로 봇 생성 후 토큰 발급,
# 봇과 대화를 시작한 뒤 https://api.telegram.org/bot<토큰>/getUpdates 로 chat id 확인
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
